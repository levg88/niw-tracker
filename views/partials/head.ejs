<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · <%= appName %></title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/">
      <span class="brand-mark">NIW</span>
      <span class="brand-text">
        <strong>Evidence Tracker</strong>
        <small>EB-2 · exceptional ability</small>
      </span>
    </a>
    <nav class="nav" aria-label="Main">
      <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">Dashboard</a>
      <a href="/evidence" class="<%= currentPath.startsWith('/evidence') ? 'active' : '' %>">Evidence</a>
      <a href="/case" class="<%= currentPath.startsWith('/case') ? 'active' : '' %>">Case profile</a>
      <a href="/report" class="<%= currentPath.startsWith('/report') ? 'active' : '' %>">Report</a>
    </nav>
  </div>
</header>
<main id="main" class="wrap main">
  <% if (message) { %><div class="flash flash-ok" role="status"><%= message %></div><% } %>
  <% if (flashError) { %><div class="flash flash-error" role="alert"><%= flashError %></div><% } %>
